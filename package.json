{
  "name": "@valentindft/ng-base-config",
  "version": "1.2.1",
  "description": "Config ESLint, Prettier, TypeScript et lint-staged partagee entre tous les projets Angular",
  "license": "MIT",
  "type": "commonjs",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig",
    "lint-staged",
    "stylelint"
  ],
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./lint-staged": "./lint-staged/index.js",
    "./stylelint": "./stylelint/index.js"
  },
  "peerDependencies": {
    "@eslint/js": ">=9.0.0",
    "angular-eslint": ">=18.0.0",
    "typescript-eslint": ">=8.0.0",
    "stylelint": ">=16.0.0",
    "stylelint-config-standard-scss": ">=13.0.0"
  }
}
