{
  "name": "@valentindft/ng-base-config",
  "version": "1.2.4",
  "description": "Config ESLint, Prettier, TypeScript, Stylelint et lint-staged partagee entre tous les projets Angular",
  "license": "MIT",
  "author": "Valentin Duffet",
  "homepage": "https://github.com/ValentinDft/ng-base-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValentinDft/ng-base-config.git"
  },
  "bugs": {
    "url": "https://github.com/ValentinDft/ng-base-config/issues"
  },
  "keywords": [
    "angular",
    "eslint-config",
    "prettier-config",
    "stylelint-config",
    "tsconfig",
    "lint-staged",
    "typescript"
  ],
  "type": "commonjs",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig",
    "lint-staged",
    "stylelint"
  ],
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./lint-staged": "./lint-staged/index.js",
    "./stylelint": "./stylelint/index.js"
  },
  "peerDependencies": {
    "@eslint/js": ">=9.0.0",
    "angular-eslint": ">=18.0.0",
    "typescript-eslint": ">=8.0.0",
    "stylelint": ">=16.0.0",
    "stylelint-config-standard-scss": ">=13.0.0"
  }
}